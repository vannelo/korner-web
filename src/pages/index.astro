  >
    <div class="container mx-auto py-8 relative px-4 md:px-0">
      <div class="md:flex items-center justify-center">
        <div class="md:w-1/2 text-center">
          <h2 class="text-4xl bg-primary text-black inline-block px-4 py-2">
